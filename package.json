{
  "name": "researchclip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "node scripts/with-rust.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "node scripts/with-rust.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format:rust": "node scripts/with-rust.mjs cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "tauri": "node scripts/with-rust.mjs tauri",
    "desktop:dev": "npm run tauri -- dev",
    "desktop:build": "npm run tauri -- build --no-bundle",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "konva": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "playwright-core": "^1.58.0"
  },
  "packageManager": "npm@10.9.7"
}
