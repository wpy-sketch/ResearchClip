{
  "manifest_version": 3,
  "name": "ResearchClip 网页剪藏",
  "version": "1.0.2",
  "description": "用户主动剪藏网页到本机 ResearchClip",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https:; object-src 'none'; base-uri 'none'"
  }
}
